{
  "name": "samsal-website",
  "version": "3.0.0",
  "private": true,
  "description": "Corporate website and business management platform for SAMSAL Supply & Distribution Limited",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "brand:assets": "node scripts/generate-brand-assets.cjs",
    "db:seed:generate": "tsx scripts/generate-seed.ts",
    "db:test": "bash supabase/tests/run-local.sh",
    "test:security": "tsx tests/security.test.ts",
    "security:audit": "node scripts/security-audit.mjs",
    "security:deps": "npm audit --omit=dev --audit-level=high",
    "check": "npm run typecheck && npm run security:audit && npm run test:security && npm run test:portal && npm run test:mpesa",
    "test:portal": "tsx tests/portal.test.ts",
    "test:mpesa": "tsx tests/mpesa.test.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.0",
    "lucide-react": "^0.469.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2"
  }
}
