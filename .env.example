# ------------------------------------------------------------------
# SAMSAL website - environment variables
# Copy to .env.local for development. In production set these in the
# Vercel dashboard (Project > Settings > Environment Variables).
# NEVER commit real values.
# ------------------------------------------------------------------

# Primary public domain (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://samsal.co.ke

# ---- Business contact details (shown on the site) -----------------
# Leave blank until confirmed. Blank values show a clearly marked
# "to be added" placeholder; the WhatsApp button stays hidden until set.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
# WhatsApp number in international format, digits only (e.g. 2547XXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_BUSINESS_HOURS=

# ---- Quotation / enquiry email delivery (server-side only) --------
# Resend: https://resend.com  (free tier is enough to start)
RESEND_API_KEY=
# Where enquiries are delivered. Comma-separate multiple addresses.
QUOTE_TO_EMAIL=
# Sender. Must be on a domain verified in Resend, e.g.
# "SAMSAL Website <quotes@samsal.co.ke>". For testing only you can use
# "SAMSAL Website <onboarding@resend.dev>" (delivers only to your own Resend account email).
QUOTE_FROM_EMAIL=

# ---- Anti-spam (server-side only) ---------------------------------
# Secret used to sign the "form opened" timing token. Generate one with:
#   openssl rand -hex 32
# Strongly recommended in production (the timing check is skipped without it).
FORM_TOKEN_SECRET=

# Shared rate limiting for serverless (Upstash Redis REST). Free tier is enough.
# Vercel: Project > Storage / Marketplace > Upstash Redis adds these automatically.
# Without them the limiter is per-instance memory only (weaker).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Optional: Cloudflare Turnstile (free CAPTCHA alternative) ----
# If both are set, the forms show the widget and the server verifies it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
